# Ejemplo documental: el instalador genera /opt/codi/waha-prod/.env (modo 600).
# La clave sin hash se guarda separada en /opt/codi/waha-prod/.api-key.
WAHA_API_KEY=sha512:REEMPLAZAR_CON_HASH_SHA512
WAHA_DASHBOARD_ENABLED=false
WHATSAPP_SWAGGER_ENABLED=false
WAHA_PRINT_QR=False
WHATSAPP_DEFAULT_ENGINE=GOWS
WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_FOLDER=/app/.media
WHATSAPP_FILES_LIFETIME=0
