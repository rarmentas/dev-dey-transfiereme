POSTGRES_USER=cody
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=transfiereme.asware.com.mx
WEBHOOK_BASE_URL=https://transfiereme.asware.com.mx
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
