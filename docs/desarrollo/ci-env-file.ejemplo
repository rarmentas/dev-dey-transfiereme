# Contenido de la variable File PROD_ENV_FILE (master) o TEST_ENV_FILE (rama test).
# Rellene los secretos aquí. No los cree como variables sueltas de CI.
# No ponga host, usuario, puerto, ruta ni llave SSH: eso es del deploy
# (PROD_DEPLOY_* / TEST_DEPLOY_* y PROD_SSH_PRIVATE_KEY / TEST_SSH_PRIVATE_KEY en base64).

POSTGRES_DB=cody
POSTGRES_USER=cody
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
# En intec-vps-001, deploy/compose.yaml publica Cody en 5435.
# 5432 es el Postgres del sistema, 5433 denti-demo y 5434 denti-prod.
POSTGRES_PORT=5435
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=transfiereme.asware.com.mx
WEBHOOK_BASE_URL=https://transfiereme.asware.com.mx
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
EMAIL_HOST=mail.asware.com.mx
EMAIL_PORT=465
EMAIL_HOST_USER=transfiereme@asware.com.mx
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=transfiereme@asware.com.mx
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
