<diagram id="bancos" name="Varios bancos">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="n79" value="Ejemplo para ver el cruce. Quien cobra tiene BBVA y Banorte, con CoDi validado en las dos. La app predeterminada de su teléfono es Banorte. Quien paga tiene Santander y HSBC, con CoDi validado en las dos. La predeterminada es Santander, pero el saldo de esta compra está en HSBC." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="56" width="1552" height="100" as="geometry"/></mxCell>
<mxCell id="n80" value="Si cobran con QR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="180" width="760" height="40" as="geometry"/></mxCell>
<mxCell id="n81" value="Si cobran con notificación" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="816" y="180" width="760" height="40" as="geometry"/></mxCell>
<mxCell id="n82" value="1. Quien cobra elige la app antes de generar el QR.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;BBVA deposita en BBVA. Banorte deposita en Banorte. Quien paga no escoge esa cuenta.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="236" width="760" height="96" as="geometry"/></mxCell>
<mxCell id="n83" value="2. Quien paga abre HSBC, que es donde está el saldo.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;Puede ignorar Santander, aunque Santander sea la app predeterminada.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="348" width="760" height="96" as="geometry"/></mxCell>
<mxCell id="n84" value="3. Escanea el QR de la app que el vendedor dejó abierta y autoriza." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="460" width="760" height="84" as="geometry"/></mxCell>
<mxCell id="n85" value="4. El dinero sale de HSBC y entra a la cuenta que iba dentro del QR." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="560" width="760" height="84" as="geometry"/></mxCell>
<mxCell id="n86" value="5. Si abre Santander por costumbre, el cargo sale de Santander.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;En el QR, la app que se abre es la que paga. La predeterminada no interviene.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="660" width="760" height="88" as="geometry"/></mxCell>
<mxCell id="n87" value="1. Quien cobra manda el aviso al celular desde la app que eligió.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;La cuenta destino es la de esa app, no la de Banorte por ser la predeterminada.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="816" y="236" width="760" height="96" as="geometry"/></mxCell>
<mxCell id="n88" value="2. El teléfono de quien paga abre Santander.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;Banxico entrega el aviso a la única app predeterminada, no a la del saldo.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="816" y="348" width="760" height="96" as="geometry"/></mxCell>
<mxCell id="n89" value="3. Santander muestra el cobro. Si no hay saldo, no puede brincar a HSBC.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;Rechaza o pospone. El aviso no se redirige al otro banco.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="816" y="460" width="760" height="96" as="geometry"/></mxCell>
<mxCell id="n90" value="4. Para usar HSBC hay que cambiar la app predeterminada y pedir el aviso otra vez.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;Eso es configuración del teléfono, no un paso de la caja. O se pasa al QR y se abre HSBC.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="816" y="572" width="760" height="100" as="geometry"/></mxCell>
<mxCell id="n91" value="5. En la caja, ese rodeo se abandona. El cobro vuelve a efectivo." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="816" y="688" width="760" height="80" as="geometry"/></mxCell>
<mxCell id="n100" value="Dentro de una misma app, el banco puede dejar elegir la cuenta al cobrar: Banorte lo muestra así. Otros manuales, como el de Bankaool, dicen que solo queda activa la última cuenta validada.&lt;br&gt;Entre dos apps las cuentas no se mezclan. Cada app genera el cobro hacia su propia cuenta.&lt;br&gt;La app CoDi de Banxico solo cobra. Puede tener registrada la CLABE de BBVA o la de Banorte, pero quien paga no autoriza el cargo ahí: lo autoriza en la app de su banco.&lt;br&gt;Reglas tomadas de la FAQ de codi.org.mx y de las guías de Banorte, HSBC y Bankaool. Los cuatro bancos de esta hoja son un ejemplo." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fffdf5;strokeColor=#d6b656;size=14;align=left;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=13;fontColor=#1a1a1a;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="24" y="804" width="1552" height="160" as="geometry"/></mxCell>
<mxCell id="e92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#333333;strokeColor=#666666;" edge="1" parent="1" source="n82" target="n83"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#333333;strokeColor=#666666;" edge="1" parent="1" source="n83" target="n84"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e94" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#333333;strokeColor=#666666;" edge="1" parent="1" source="n84" target="n85"><mxGeometry relative="1" as="geometry"/></mxCell>
