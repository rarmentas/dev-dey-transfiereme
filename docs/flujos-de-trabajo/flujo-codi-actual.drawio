<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="dev-day-cody" version="22.1.0" type="device">
<diagram id="pasos" name="Pasos y fricción">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2780" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="n1" value="Paso normal" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="56" width="150" height="36" as="geometry"/></mxCell>
<mxCell id="n2" value="Aquí se atora" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="186" y="56" width="160" height="36" as="geometry"/></mxCell>
<mxCell id="n3" value="El cobro se cae" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="358" y="56" width="170" height="36" as="geometry"/></mxCell>
<mxCell id="n4" value="El dinero ya se movió" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="540" y="56" width="200" height="36" as="geometry"/></mxCell>
<mxCell id="n5" value="Decisión" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="752" y="56" width="130" height="36" as="geometry"/></mxCell>
<mxCell id="n6" value="A.  Antes del primer cobro. Se hace una vez por cada app, no por persona." style="fillColor=#f7f7f7;strokeColor=#e6e6e6;fontColor=#666666;fontStyle=1;rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="112" width="1552" height="36" as="geometry"/></mxCell>
<mxCell id="n7" value="Quien cobra, el vendedor" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="164" width="760" height="40" as="geometry"/></mxCell>
<mxCell id="n8" value="Quien paga" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="816" y="164" width="760" height="40" as="geometry"/></mxCell>
<mxCell id="n9" value="1. Cuenta de depósitos en un banco que ofrezca CoDi.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;No está en todos los bancos. La app CoDi de Banxico solo sirve para cobrar, no para pagar.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="220" width="760" height="84" as="geometry"/></mxCell>
<mxCell id="n10" value="2. Abre esa app y busca la sección CoDi.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;Queda dentro de los menús. En algunos bancos hay que salir de la sesión para entrar.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="320" width="760" height="84" as="geometry"/></mxCell>
<mxCell id="n11" value="3. Acepta términos, recibe un SMS en el celular del banco y elige la cuenta.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;El SMS a veces no llega. El call center del banco no siempre sabe qué es CoDi.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="420" width="760" height="96" as="geometry"/></mxCell>
<mxCell id="n12" value="4. Espera la validación. El banco abona $0.01 a esa cuenta.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;Las guías de los bancos dicen unos 5 minutos. En una prueba de 2019 hubo altas de media hora.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="532" width="760" height="96" as="geometry"/></mxCell>
<mxCell id="n13" value="5. Si ya usa CoDi en otra app, elige si esta queda como predeterminada.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;El teléfono solo tiene una app predeterminada. Esa es la que recibe los avisos de cobro.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="644" width="760" height="96" as="geometry"/></mxCell>
<mxCell id="n14" value="1. Cuenta de depósitos. Elige el banco donde tendrá saldo.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;La tarjeta de crédito no paga CoDi. Hace falta una cuenta de depósitos.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="816" y="220" width="760" height="84" as="geometry"/></mxCell>
<mxCell id="n15" value="2. Abre la app de ese banco y busca CoDi.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;CoDi activado en otro banco no sirve para pagar desde este saldo.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="816" y="320" width="760" height="84" as="geometry"/></mxCell>
<mxCell id="n16" value="3. Activa con el SMS y valida esa cuenta.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;Mismo trámite del SMS. Si falla, esa app queda inutilizable para pagar.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="816" y="420" width="760" height="96" as="geometry"/></mxCell>
<mxCell id="n17" value="4. Espera el abono de $0.01 en esa cuenta." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="816" y="532" width="760" height="96" as="geometry"/></mxCell>
<mxCell id="n18" value="5. Si le van a cobrar por notificación, esta app debe ser la predeterminada.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;Si la predeterminada es otro banco, el aviso de cobro no va a llegar aquí.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="816" y="644" width="760" height="96" as="geometry"/></mxCell>
<mxCell id="n19" value="Los dos tienen que haber hecho este alta en la app que van a usar hoy. Los dos teléfonos necesitan internet en ese momento." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="772" width="1552" height="64" as="geometry"/></mxCell>
<mxCell id="n20" value="¿La app de cada quien ya está validada y hay internet?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="870" width="700" height="130" as="geometry"/></mxCell>
<mxCell id="n21" value="No. El cobro no arranca. Se paga en efectivo o con un SPEI capturado a mano. Activar CoDi en la caja no alcanza." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="1040" width="740" height="88" as="geometry"/></mxCell>
<mxCell id="n22" value="Sí. Pasan a la caja con la app que ya quedó lista." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="816" y="1040" width="760" height="88" as="geometry"/></mxCell>
<mxCell id="n23" value="B.  En la caja, en cada venta" style="fillColor=#f7f7f7;strokeColor=#e6e6e6;fontColor=#666666;fontStyle=1;rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="1160" width="1552" height="36" as="geometry"/></mxCell>
<mxCell id="n24" value="6. Quien cobra elige el banco que debe recibir el dinero y abre esa app.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;El QR y la notificación llevan la cuenta de esa app. Si abre otro banco, el dinero cae en el otro.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="1212" width="1552" height="84" as="geometry"/></mxCell>
<mxCell id="n25" value="7. Entra a Cobrar. Escribe monto, concepto y una referencia de hasta 7 dígitos.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;Son varios toques dentro de la app. Si cierra la pantalla del QR, tiene que generarlo otra vez.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="1312" width="1552" height="84" as="geometry"/></mxCell>
<mxCell id="n26" value="8. ¿Cómo entrega el cobro?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="1430" width="400" height="150" as="geometry"/></mxCell>
<mxCell id="n27" value="Con código QR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="1620" width="500" height="36" as="geometry"/></mxCell>
<mxCell id="n28" value="Con notificación al celular" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="544" y="1620" width="500" height="36" as="geometry"/></mxCell>
<mxCell id="n29" value="Con NFC, si existe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1064" y="1620" width="512" height="36" as="geometry"/></mxCell>
<mxCell id="n30" value="9. Muestra el QR y no cierra esa pantalla.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;Si la cierra, el código deja de servir y hay que generarlo de nuevo.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="1672" width="500" height="88" as="geometry"/></mxCell>
<mxCell id="n31" value="10. Quien paga abre la app donde sí tiene saldo.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;El QR no elige banco. Puede ignorar la app predeterminada y abrir otra.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="1776" width="500" height="96" as="geometry"/></mxCell>
<mxCell id="n32" value="11. Escanea el QR o lo importa de la galería. Revisa beneficiario, monto y concepto." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="1888" width="500" height="96" as="geometry"/></mxCell>
<mxCell id="n33" value="12. Si el QR no trae monto, quien paga lo escribe. Autoriza con NIP, huella o token.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;El monto lo teclea la otra persona. Algunos bancos piden además un token.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="2000" width="500" height="100" as="geometry"/></mxCell>
<mxCell id="n34" value="9. Pide el celular y envía el aviso.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;Tiene que ser el número que el banco de quien paga tiene registrado.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="544" y="1672" width="500" height="88" as="geometry"/></mxCell>
<mxCell id="n35" value="10. Banxico entrega el aviso a una sola app: la predeterminada del teléfono.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;Si el saldo está en otra app, este aviso no se puede pagar desde ahí.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="544" y="1776" width="500" height="100" as="geometry"/></mxCell>
<mxCell id="n36" value="11. Quien paga elige: pagar ahora, posponer o rechazar." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="544" y="1892" width="500" height="88" as="geometry"/></mxCell>
<mxCell id="n37" value="12. Si acepta, autoriza con NIP, huella o token." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="544" y="1996" width="500" height="80" as="geometry"/></mxCell>
<mxCell id="n38" value="Si rechaza, quien cobra recibe ese aviso. No hay abono." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="544" y="2092" width="500" height="72" as="geometry"/></mxCell>
<mxCell id="n39" value="9. Acercan los dos teléfonos.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a3412&quot;&gt;Hace falta NFC en los dos aparatos y que las dos apps lo ofrezcan.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1064" y="1672" width="512" height="88" as="geometry"/></mxCell>
<mxCell id="n40" value="10. Quien paga confirma el cobro en la app que se abrió." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1064" y="1776" width="512" height="80" as="geometry"/></mxCell>
<mxCell id="n41" value="Si no hay NFC, este camino no existe. El cobro sigue por QR." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1064" y="1872" width="512" height="80" as="geometry"/></mxCell>
<mxCell id="n42" value="13. Mismo banco: traspaso interno. Bancos distintos: SPEI. CoDi no cobra comisión por la operación." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="2220" width="1552" height="72" as="geometry"/></mxCell>
<mxCell id="n43" value="14. Los dos reciben el aviso de que el dinero ya está en la cuenta de quien cobra." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="2312" width="1552" height="64" as="geometry"/></mxCell>
<mxCell id="n44" value="Si no llega el aviso y el dinero no se ve, no se reversa solo. Se aclara con el banco, como cualquier transferencia, o con Banxico: folio, fecha y 800 767 2634." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="24" y="2400" width="1552" height="80" as="geometry"/></mxCell>
<mxCell id="n45" value="Esto no es un paso de la caja. Es lo que hace que la gente abandone los pasos de arriba.&lt;br&gt;Estudio encargado por Banxico a Tag Research, citado por Forbes: efectivo, informalidad, miedo a que el SAT vea el pago, datos de prepago y poca ventaja percibida frente a la tarjeta o al SPEI.&lt;br&gt;Tener la cuenta validada no es usarla. Milenio recuerda el corte de 2021: 12 millones de cuentas validadas, 770 mil habían pagado al menos una vez y 616 mil habían cobrado.&lt;br&gt;El banco no gana comisión. Ofrecer CoDi no fue obligatorio para todas las instituciones, a diferencia de Pix en Brasil. Sheinbaum lo dijo en público y El Economista lo recogió en 2025: los bancos no lo promueven.&lt;br&gt;Para meter CoDi en un punto de venta, el comercio además se registra ante Banxico. Siigo Aspel documenta una validación de 48 a 72 horas, distinta del alta de unos 5 minutos en la app." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fffdf5;strokeColor=#d6b656;size=14;align=left;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=13;fontColor=#1a1a1a;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="24" y="2512" width="1552" height="220" as="geometry"/></mxCell>
<mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#333333;strokeColor=#666666;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#333333;strokeColor=#666666;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#333333;strokeColor=#666666;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#333333;strokeColor=#666666;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#333333;strokeColor=#666666;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
