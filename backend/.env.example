# Copie este archivo a backend/.env. No lo suba al repositorio.
# En GitLab, el mismo contenido va en PROD_ENV_FILE (master) o TEST_ENV_FILE (rama test).
# Rellene ahí los secretos de la app. En local puede dejar vacías las de pey.
#
# Sí van en este archivo:
#   POSTGRES_PASSWORD, DJANGO_SECRET_KEY, PEY_API_KEY, PEY_WEBHOOK_SECRET
# No van aquí (son variables de CI del deploy):
#   DEPLOY_HOST, DEPLOY_USER, DEPLOY_PORT, DEPLOY_PATH, SSH_PRIVATE_KEY (base64 en CI)

POSTGRES_DB=cody
POSTGRES_USER=cody
POSTGRES_PASSWORD=cody_local_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

DJANGO_SECRET_KEY=cambie-esta-clave-local-solo-desarrollo
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

WEBHOOK_BASE_URL=https://transfiereme.asware.com.mx
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
