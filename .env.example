# Copie este archivo a backend/.env. No lo suba al repositorio.
# En GitLab, el mismo contenido va en PROD_ENV_FILE (master) o TEST_ENV_FILE (rama test).
# Rellene ahí los secretos de la app. En local puede dejar vacías las de pey.
#
# Sí van en este archivo:
#   POSTGRES_PASSWORD, DJANGO_SECRET_KEY, PEY_API_KEY, PEY_WEBHOOK_SECRET
# No van aquí (son variables de CI del deploy):
#   PROD_DEPLOY_*, PROD_SSH_PRIVATE_KEY_V2 (base64 en CI); TEST_* reservado

POSTGRES_DB=cody
POSTGRES_USER=cody
POSTGRES_PASSWORD=cody_local_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

DJANGO_SECRET_KEY=cambie-esta-clave-local-solo-desarrollo
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

WEBHOOK_BASE_URL=https://transfiereme.asware.com.mx
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
PEY_ADAPTADOR=desarrollo

EMAIL_HOST=mail.asware.com.mx
EMAIL_PORT=465
EMAIL_HOST_USER=transfiereme@asware.com.mx
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=transfiereme@asware.com.mx
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

NUCLEO_ADAPTADOR=real
PEDIDOS_COBRO_HABILITADO=false
# Demo: CuentaCobro seleccionada (cuenta_por_defecto) ACTIVE, importe MXN 0.01.
# Variable obsoleta e ignorada; no define el destino ni es requerida.
DEMO_PEY_BANK_ACCOUNT_ID=
WAHA_BASE_URL=http://127.0.0.1:3004
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WAHA_INSTANCIA=waha

STT_HABILITADO=0
STT_MODELO=small
STT_CPU_THREADS=2
GEMINI_API_KEY=
GEMINI_LIVE_MODELO=gemini-2.5-flash-native-audio-preview-12-2025

# El agente de pedidos se habilita por comercio en la app.
# También acepta OPENAI_API_KEY si no se define AGENTE_PEDIDOS_API_KEY.
AGENTE_PEDIDOS_API_KEY=
AGENTE_PEDIDOS_MODELO=gpt-4.1-mini
AGENTE_PEDIDOS_TIMEOUT_S=25
