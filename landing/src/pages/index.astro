import AsiDeFacil from '../components/landing/AsiDeFacil.astro';
import VideoDemo from '../components/landing/VideoDemo.astro';
import Funciones from '../components/landing/Funciones.astro';
import Ventajas from '../components/landing/Ventajas.astro';
import Seguridad from '../components/landing/Seguridad.astro';
